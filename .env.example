# Google Gemini API key (for Gemini models and Gemma models on Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Other providers if running multi-provider evaluations
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: Langfuse tracing (self-hosted or cloud)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
